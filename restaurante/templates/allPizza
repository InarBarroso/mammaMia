
{% block title %}Nuestras Pizzas{% endblock %}

{% block extra_css %}
    <link rel="stylesheet" href="{% static 'css/main.css' %}">
{% endblock %}

{%block content%}
        <main>

                <div id="portada1">
                <h1>Todas Nuestras Pizzas</h1>
                </div>
                
            </div>
            <div id="all_pizzas">
                <div id="tit_all_pizzas">
                    <h2>Las más vendidas</h2>
                </div>
                <div id="show_pizzas">

                    {%for pizza in pizzas%}
                    <section>
                        <img src="{{pizza.imagen.url}}" alt="imagen">
                        <div>
                        <h3>{{pizza.titulo}}</h3>
                        <h3>{{pizza.descripcion}}</h3>
                        <a href="{% url 'filtrarpizza' pizza.id %}" id="boton">Detalles</a>
                        </div>
                    </section>
                    {%endfor%}
                    
                </div>
            </div>

        
        </main>

{%endblock%}
