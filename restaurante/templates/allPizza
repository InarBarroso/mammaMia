
<!DOCTYPE html>
<html lang="es">
    <head>
        <title>Sushi Dragon</title>
        <link rel="stylesheet" href="main.css">
        <link rel="shortcut icon" href="logo.svg" >
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cherry+Cream+Soda&family=Inconsolata:wght@200..900&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    </head>

    <body>
       

        <main>

                <div id="portada1">
                <h1>Todas Nuestras Pizzas</h1>
                </div>
                
            </div>
            <div id="all_pizzas">
                <div id="tit_all_pizzas">
                    <h2>Las más vendidas</h2>
                </div>
                <div id="show_pizzas">

                    {%for pizza in pizzas%}
                    <section>
                        <img src="{{pizza.imagen.url}}" alt="imagen">
                        <div>
                        <h3>{{pizza.titulo}}</h3>
                        <h3>{{pizza.descripcion}}</h3>
                        <a href="{% url 'filtrarpizza' pizza.id %}" id="boton">Detalles</a>
                        </div>
                    </section>
                    {%endfor%}
                    
                </div>
            </div>

        
        </main>


    </body>


</html>